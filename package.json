{
  "name": "onlinecopypaste",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json server.ts",
    "build": "next build",
    "start": "NODE_ENV=production ts-node --project tsconfig.server.json server.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "cf:build": "npm run cf:typegen && opennextjs-cloudflare build && npx esbuild src/do/SignalingRoom.ts --bundle --format=esm --platform=browser --external:node:crypto --conditions=worker --outfile=.open-next/signaling-room.js && node scripts/patch-worker.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && npx wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "10.2.9",
    "@opennextjs/cloudflare": "1.14.7",
    "jose": "5.9.6",
    "jsonwebtoken": "9.0.2",
    "next": "14.2.35",
    "prismjs": "1.29.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "10.0.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.0.0",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.0",
    "@types/prismjs": "1.26.4",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.5.10",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.18",
    "jsdom": "24.1.0",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "vitest": "1.6.0",
    "wrangler": "4.53.0"
  }
}
