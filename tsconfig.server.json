{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "lib": ["ES2017"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".server-build",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["server.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", "src/app", "src/components", "src/hooks"]
}
